{
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "args": ["-i"]
    }
  },
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.associations": {
    "*.json": "jsonc",
    "*.fs": "featurescript"
  },
  "files.eol": "\n",
  "cSpell.allowCompoundWords": true,
  "cSpell.ignorePaths": ["build", ".git", ".vscode", ".devcontainer", "std"],
  "cSpell.words": [
    "apikey",
    "creds",
    "digestmod",
    "dotenv",
    "featurescripts",
    "FEATURESTUDIO",
    "Kempen",
    "levelname",
    "Onshape",
    "pygls",
    "regen"
  ],
  "cSpell.flagWords": ["coincentric", "expresion"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // Search only featurescripts/: everything else at the top of the repo is excluded
  "search.exclude": {
    "**/node_modules": true,
    "**/*.pyc": true,
    "**/assets": true,
    "**/dist": true,
    "**/*.code-search": true,
    "docs": true,
    "fs_cli": true,
    "onshape_api": true,
    "onshape_icons": true,
    "std": true,
    "temp": true,
    "tests": true,
    "vscode-extension": true,
    "*.md": true,
    "*.json": true,
    "*.toml": true,
    "*.lock": true,
    "LICENSE": true
  },
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false
}
